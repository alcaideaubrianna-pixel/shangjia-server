PORT=3001

# Optional API key between HotGo and PocketPing bridge-server.
API_KEY=youban-local-pocketping

# Telegram bridge. Fill these before starting real TG bridge.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Operator replies are posted back to HotGo.
BACKEND_WEBHOOK_URL=http://host.docker.internal:8000/api/youban_chat/chat/webhook
