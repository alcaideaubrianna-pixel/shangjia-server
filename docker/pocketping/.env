PORT=3001

# Optional API key between HotGo and PocketPing bridge-server.
API_KEY=youban-local-pocketping

# Bridge runtime config is fetched from HotGo. API_KEY is the bootstrap key for this request.
HOTGO_CHAT_CONFIG_URL=http://host.docker.internal:8000/api/youban_chat/chat/bridgeConfig
TELEGRAM_TOPIC_MAP_PATH=/data/telegram-topic-map.json

# Operator replies are posted back to HotGo. These are fallback values before remote config is loaded.
BACKEND_WEBHOOK_URL=http://host.docker.internal:8000/api/youban_chat/chat/webhook
EVENTS_WEBHOOK_URL=http://host.docker.internal:8000/api/youban_chat/chat/webhook
