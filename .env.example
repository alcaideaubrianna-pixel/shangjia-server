# Zeabur 构建期变量：Docker 构建 Vite 后台前端时读取。
VITE_PUBLIC_PATH=/admin
VITE_BASE_URL=/
VITE_DROP_CONSOLE=true
VITE_GLOB_API_URL=
VITE_GLOB_UPLOAD_URL=
VITE_GLOB_IMG_URL=
VITE_GLOB_API_URL_PREFIX=/admin
VITE_BUILD_COMPRESS=none
VITE_BUILD_COMPRESS_DELETE_ORIGIN_FILE=false
VITE_GLOB_APP_TITLE=Youban
VITE_GLOB_APP_SHORT_NAME=HG
VITE_APP_DEMO_ACCOUNT=

# Zeabur 运行期变量：容器启动时读取。
PORT=8000
TZ=Asia/Shanghai
APP_MODE=product
APP_DEBUG=false

# 后端配置覆盖：deploy/zeabur/entrypoint.sh 会在 Go 服务启动前
# 将这些变量写入 server/manifest/config/config.yaml。
DATABASE_DEFAULT_LINK=pgsql:postgres:postgres@tcp(postgres.zeabur.internal:5432)/youban_hotgo
DATABASE_DEBUG=false
DATABASE_PREFIX=hg_

# Redis 配置。
REDIS_ADDRESS=redis.zeabur.internal:6379
REDIS_DB=3
REDIS_PASS=

# 缓存、队列、登录令牌配置。
CACHE_ADAPTER=redis
QUEUE_DRIVER=redis
TOKEN_SECRET_KEY=change-me
