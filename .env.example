# 1Panel 编排变量：用于 docker compose 或面板创建容器，不是 HotGo 运行配置。
SERVER_IMAGE=ghcr.io/alcaideaubrianna-pixel/youban-server:latest
CONTAINER_NAME=youban-server
HTTP_PORT=8000
DOCKER_NETWORK=1panel-network
TZ=Asia/Shanghai
HOTGO_CONFIG_FILE=/opt/youban/config.yaml

# 前端构建期变量：Docker 构建 Vite 后台前端时读取。
VITE_PUBLIC_PATH=/admin
VITE_BASE_URL=/
VITE_DROP_CONSOLE=true
VITE_GLOB_API_URL=
VITE_GLOB_UPLOAD_URL=
VITE_GLOB_IMG_URL=
VITE_GLOB_API_URL_PREFIX=/admin
VITE_BUILD_COMPRESS=none
VITE_BUILD_COMPRESS_DELETE_ORIGIN_FILE=false
VITE_GLOB_APP_TITLE=Youban
VITE_GLOB_APP_SHORT_NAME=HG
VITE_APP_DEMO_ACCOUNT=

# HotGo 后端原生读取 /app/manifest/config/config.yaml。
# 数据库、Redis、缓存、队列、Token、运行模式等配置请写入 config.yaml，
# 不要依赖 .env 自动覆盖。

# GitHub Actions 需要在仓库 Secrets 中配置以下值，不要写入真实 .env：
# ONEPANEL_BASE_URL=https://1panel.example.com
# ONEPANEL_API_KEY=
# ONEPANEL_CONTAINER_NAME=youban-server
