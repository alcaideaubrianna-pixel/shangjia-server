{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "HotGo Server: all",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/server/main.go",
      "cwd": "${workspaceFolder}/server",
      "args": ["all"],
      "env": {
        "GF_GCFG_PATH": "manifest/config",
        "GF_GCFG_FILE": "config.yaml"
      }
    },
    {
      "name": "HotGo Server: http",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/server/main.go",
      "cwd": "${workspaceFolder}/server",
      "args": ["http"],
      "env": {
        "GF_GCFG_PATH": "manifest/config",
        "GF_GCFG_FILE": "config.yaml"
      }
    },
    {
      "name": "HotGo Server: cron",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/server/main.go",
      "cwd": "${workspaceFolder}/server",
      "args": ["cron"],
      "env": {
        "GF_GCFG_PATH": "manifest/config",
        "GF_GCFG_FILE": "config.yaml"
      }
    },
    {
      "name": "HotGo Server: queue",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/server/main.go",
      "cwd": "${workspaceFolder}/server",
      "args": ["queue"],
      "env": {
        "GF_GCFG_PATH": "manifest/config",
        "GF_GCFG_FILE": "config.yaml"
      }
