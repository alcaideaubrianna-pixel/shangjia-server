# 镜像与容器编排
YOUBAN_SERVER_IMAGE=ghcr.io/alcaideaubrianna-pixel/youban-server:latest
YOUBAN_H5_IMAGE=
YOUBAN_HTTP_PORT=8000
YOUBAN_H5_PORT=9000
YOUBAN_DOCKER_NETWORK=1panel-network
YOUBAN_TZ=Asia/Shanghai

# HotGo 基础配置
YOUBAN_APP_NAME=youban
YOUBAN_MODE=product
YOUBAN_DEBUG=false
YOUBAN_SERVER_PORT=8000
YOUBAN_TOKEN_SECRET=change-me
# 运行角色：all、web、worker、account、scheduler；多个角色用逗号分隔。
YOUBAN_PUBLISH_RUNTIME_ROLES=all
# 首次部署空数据库时设为 true，会自动导入 HotGo 基础表；已有表时不会重复导入。
YOUBAN_AUTO_INIT_DATABASE=true

# PostgreSQL
YOUBAN_DB_DRIVER=pgsql
YOUBAN_DB_HOST=1Panel-postgresql
YOUBAN_DB_PORT=5432
YOUBAN_DB_NAME=youban
YOUBAN_DB_USER=youban
YOUBAN_DB_PASSWORD=change-me
YOUBAN_DB_PREFIX=hg_
YOUBAN_DB_DEBUG=false
# 如果需要完全自定义连接串，设置此项会覆盖上面的 DB_HOST/PORT/NAME/USER/PASSWORD。
YOUBAN_DATABASE_LINK=

# Redis
YOUBAN_REDIS_HOST=1Panel-redis
YOUBAN_REDIS_PORT=6379
YOUBAN_REDIS_DB=3
YOUBAN_REDIS_PASSWORD=
YOUBAN_CACHE_ADAPTER=redis
YOUBAN_QUEUE_DRIVER=redis

# 采集媒体队列：4 核 8G 单实例推荐初始值。
# 运行稳定后可将 MEDIA_WORKER_CONCURRENCY 从 6 调整到 8。
YOUBAN_PUBLISH_MEDIA_WORKER_CONCURRENCY=6
YOUBAN_PUBLISH_GLOBAL_MEDIA_CONCURRENCY=8
YOUBAN_PUBLISH_ACCOUNT_MEDIA_CONCURRENCY=2
YOUBAN_PUBLISH_MEDIA_FILE_CONCURRENCY=2
YOUBAN_PUBLISH_MEDIA_DOWNLOAD_THREADS=1
YOUBAN_PUBLISH_MEDIA_BULK_SHARDS=16
YOUBAN_PUBLISH_MEDIA_REALTIME_WEIGHT=32
YOUBAN_PUBLISH_MEDIA_BULK_WEIGHT=1
YOUBAN_PUBLISH_MEDIA_RECOVERY_BATCH_SIZE=300
YOUBAN_PUBLISH_MATERIAL_WINDOW_BATCH_SIZE=100

# HotGo TCP 服务配置：默认用于主服务和独立 cron/auth 进程通讯。
# 单容器只跑 http 时一般不用改；后续 cron 拆成独立容器时，cron 地址改为主服务容器名，例如 youban-server:8099。
YOUBAN_TCP_SERVER_ADDRESS=:8099
YOUBAN_TCP_CRON_ADDRESS=127.0.0.1:8099
YOUBAN_TCP_CRON_GROUP=cron
YOUBAN_TCP_CRON_NAME=cron1
YOUBAN_TCP_CRON_APP_ID=1002
YOUBAN_TCP_CRON_SECRET_KEY=hotgo
YOUBAN_TCP_AUTH_ADDRESS=127.0.0.1:8099
YOUBAN_TCP_AUTH_GROUP=auth
YOUBAN_TCP_AUTH_NAME=auth1
YOUBAN_TCP_AUTH_APP_ID=mengshuai
YOUBAN_TCP_AUTH_SECRET_KEY=123456

# 业务可选配置
YOUBAN_CONTENT_CDN_BASE_URL=
YOUBAN_CHAT_POCKETPING_BASE_URL=
YOUBAN_CHAT_POCKETPING_API_KEY=
YOUBAN_CHAT_TELEGRAM_CHAT_ID=
YOUBAN_CHAT_TELEGRAM_WEBHOOK_BASE_URL=
