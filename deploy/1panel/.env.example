# 镜像与容器编排
YOUBAN_SERVER_IMAGE=ghcr.io/alcaideaubrianna-pixel/youban-server:latest
YOUBAN_H5_IMAGE=
YOUBAN_HTTP_PORT=8000
YOUBAN_H5_PORT=9000
YOUBAN_DOCKER_NETWORK=1panel-network
YOUBAN_TZ=Asia/Shanghai

# HotGo 基础配置
YOUBAN_APP_NAME=youban
YOUBAN_MODE=product
YOUBAN_DEBUG=false
YOUBAN_SERVER_PORT=8000
YOUBAN_TOKEN_SECRET=change-me
# 首次部署空数据库时设为 true，会自动导入 HotGo 基础表；已有表时不会重复导入。
YOUBAN_AUTO_INIT_DATABASE=true

# PostgreSQL
YOUBAN_DB_DRIVER=pgsql
YOUBAN_DB_HOST=1Panel-postgresql
YOUBAN_DB_PORT=5432
YOUBAN_DB_NAME=youban
YOUBAN_DB_USER=youban
YOUBAN_DB_PASSWORD=change-me
YOUBAN_DB_PREFIX=hg_
YOUBAN_DB_DEBUG=false
# 如果需要完全自定义连接串，设置此项会覆盖上面的 DB_HOST/PORT/NAME/USER/PASSWORD。
YOUBAN_DATABASE_LINK=

# Redis
YOUBAN_REDIS_HOST=1Panel-redis
YOUBAN_REDIS_PORT=6379
YOUBAN_REDIS_DB=3
YOUBAN_REDIS_PASSWORD=
YOUBAN_CACHE_ADAPTER=redis
YOUBAN_QUEUE_DRIVER=redis

# 业务可选配置
YOUBAN_CONTENT_CDN_BASE_URL=
YOUBAN_CHAT_POCKETPING_BASE_URL=
YOUBAN_CHAT_POCKETPING_API_KEY=
YOUBAN_CHAT_TELEGRAM_CHAT_ID=
YOUBAN_CHAT_TELEGRAM_WEBHOOK_BASE_URL=
