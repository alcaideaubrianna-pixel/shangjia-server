[Unit]
Description=Youban deploy webhook
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
EnvironmentFile=/opt/youban/deploy-webhook.env
ExecStart=/usr/bin/python3 /opt/youban/deploy-webhook.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
